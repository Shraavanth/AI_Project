# Copy to .env (optional). Everything works without this file.

# Database. Leave unset for the local SQLite file data/environmental_mas.db
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Which frontend origins may call the API (comma separated). Use your Vercel URL in production.
# ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Default monitoring area used before the browser shares a location
# DEMO_LATITUDE=12.9692
# DEMO_LONGITUDE=79.1559
# DEMO_LABEL=Demonstration area (VIT Vellore)

# Reproducible simulation (optional)
# SIM_SEED=7
