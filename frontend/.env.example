# URL of the FastAPI backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Optional: custom map tile server. Default is free OpenStreetMap tiles with dark mode theme (no API key required).
# NEXT_PUBLIC_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Optional: Google Maps JavaScript API key for Roadmap, Satellite, Terrain, and Hybrid map views
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
